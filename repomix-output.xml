<file path="apps/web/src/app/globals.css">
@import 'tailwindcss';

@theme {
  /* ── Primary ── */
  --color-primary: #4A90E2;
  --color-primary-dark: #2C6DB5;
  --color-primary-light: #EBF4FF;

  /* ── Accent ── */
  --color-accent: #FF6B6B;

  /* ── Semantic ── */
  --color-success: #4CAF88;
  --color-warning: #F5A623;

  /* ── Neutrals ── */
  --color-neutral-900: #1A1F36;
  --color-neutral-700: #4A5568;
  --color-neutral-400: #A0AEC0;
  --color-neutral-100: #F7F8FC;

  /* ── Base ── */
  --color-white: #FFFFFF;

  /* ── Column Status ── */
  --color-status-todo: #A0AEC0;
  --color-status-inprogress: #4A90E2;
  --color-status-review: #F5A623;
  --color-status-done: #4CAF88;

  /* ── Typography ── */
  --font-sans: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
  --font-size-base: 1rem;
  --line-height-base: 1.6;
  --letter-spacing-tight: -0.015em;

  /* ── Border Radius ── */
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 10px;
  --radius-full: 9999px;

  /* ── Shadows ── */
  --shadow-card: 0px 2px 8px rgba(0, 0, 0, 0.07);
  --shadow-modal: 0px 8px 24px rgba(0, 0, 0, 0.12);
  --shadow-focus: 0 0 0 3px rgba(74, 144, 226, 0.2);

  /* ── Spacing (8px grid) ── */
  --spacing-1: 8px;
  --spacing-2: 16px;
  --spacing-3: 24px;
  --spacing-4: 32px;
  --spacing-6: 48px;

  /* ── Transitions ── */
  --transition-base: 0.2s ease;
}
</file>

